/dts-v1/;

#include "rk3588-evb7-v11.dtsi"
//#include "rk3588-evb7-v11-imx415.dtsi"
#include "rk3588-linux.dtsi"

#define		ZTL_BOARD_RK3588_CM

/ {
	model = "ztl, CM588";
	compatible = "rockchip,rk3588-evb7-v11", "rockchip,rk3588";

	/*
	 * Serial consoles (5.10 variant).
	 *
	 * rk3588-linux.dtsi sets only "console=ttyFIQ0" (UART2 fiq-debugger,
	 * 1500000 8N1). This board does NOT wire UART2 out - the only reachable
	 * debug port is UART3/TTL (uart3m1: TX GPIO3_B5 / RX GPIO3_B6).
	 *
	 * Order matters: /dev/console follows the LAST console= argument, so
	 * ttyS3 is listed last to make it /dev/console (systemd's getty
	 * generator then spawns a shell on it). earlycon points at uart3's
	 * register base 0xfeb60000, NOT 0xfeb50000 (= uart2).
	 *
	 * IMPORTANT: this chosen/bootargs is only a fallback. Rockchip u-boot
	 * builds its own env "bootargs" (androidboot.fwver=... etc.) in
	 * board_fdt_chosen_bootargs(), and fdt_chosen() REPLACES this property
	 * wholesale - dropping every console= so the kernel gets no console at
	 * all. u-boot is patched to append the console= list; keep both in sync.
	 *
	 * NOTE: &gmac1 must stay disabled - gmac1_tx_bus2/gmac1_clkinout mux
	 * GPIO3_B5/GPIO3_B6, i.e. exactly the uart3 pins, and enabling gmac1
	 * makes ttyS3 completely silent.
	 */
	chosen {
		bootargs = "earlycon=uart8250,mmio32,0xfeb60000 console=ttyFIQ0 console=ttyS3,115200 irqchip.gicv3_pseudo_nmi=0 root=PARTUUID=614e0000-0000 rw rootwait rcupdate.rcu_expedited=1 rcu_nocbs=all";
	};

	vcc4v0_sys: vcc4v0-sys {
		compatible = "regulator-fixed";
		regulator-name = "vcc4v0_sys";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <4000000>;
		regulator-max-microvolt = <4000000>;
		vin-supply = <&vcc12v_dcin>;
	};

	vcc5v0_usb30_host1: vcc5v0-usb30 {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_usb30_host1";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		vin-supply = <&vcc5v0_sys>;
		regulator-boot-on;
        regulator-always-on;
	};

	vcc5v0_usb20: vcc5v0-usb20 {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_usb20";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		vin-supply = <&vcc5v0_sys>;
        regulator-boot-on;
        regulator-always-on;
	};

	vcc5v0_fan: vcc5v0-fan {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_fan";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		vin-supply = <&vcc5v0_sys>;
		regulator-boot-on;
		regulator-always-on;
        enable-active-high;
        gpio = <&gpio4 RK_PA5 GPIO_ACTIVE_HIGH>;
        pinctrl-names = "default";
        pinctrl-0 = <&vcc5v0_fan_en>;
	};

	vcc3v3_pcie20_wifi: vcc3v3-pcie20-wifi {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3_wifi";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		pinctrl-names = "default";
		pinctrl-0 = <&wifi_poweren_gpio>;
		startup-delay-us = <5000>;
		vin-supply = <&vcc_3v3_s3>;
	};

	vcc3v3_pcie30: vcc3v3-pcie30 {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3_pcie30";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&vcc12v_dcin>;
		enable-active-high;
		gpio = <&gpio2 RK_PB4 GPIO_ACTIVE_HIGH>;
	};

	modem: modem {
		compatible = "regulator-fixed";
		regulator-name = "modem";
		gpio = <&gpio3 RK_PB4 GPIO_ACTIVE_LOW>;
		regulator-boot-on;
		regulator-always-on;
	};

	vcc_mipidphy0: vcc-mipidcphy0-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vcc_mipidphy0";
		enable-active-high;
	};

	vcc_mipidphy1: vcc-mipidcphy1-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vcc_mipidphy1";
		enable-active-high;
	};
};

&display_subsystem {
	clocks = <&hdptxphy_hdmi_clk0>, <&hdptxphy_hdmi_clk1>;
	clock-names = "hdmi0_phy_pll", "hdmi1_phy_pll";
};

//cm588 dp part, use dp convert to vga
&dp1 {
	pinctrl-0 = <&dp1_hpd>;
	hpd-gpios = <&gpio3 RK_PA1 GPIO_ACTIVE_HIGH>;
	status = "okay";
};

&usbdp_phy1_dp {
	status = "okay";
};

&dp1_in_vp0 {
	status = "disabled";
};

&dp1_in_vp1 {
	status = "disabled";
};

&dp1_in_vp2 {
	status = "okay";
};

//if open route_dp1, test screen will show blurred screen
&route_dp1 {
	status = "disabled";
	connect = <&vp2_out_dp1>;
};

&spdif_tx5 {
	status = "okay";
};

&dp1_sound {
	status = "okay";
};

&i2c6 {
	usbc0: fusb302@22 {
		compatible = "fcs,fusb302";
		reg = <0x22>;
		interrupt-parent = <&gpio0>;
		interrupts = <RK_PD3 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&usbc0_int>;
		vbus-supply = <&vbus5v0_typec>;
		status = "okay";

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				usbc0_role_sw: endpoint@0 {
					remote-endpoint = <&dwc3_0_role_switch>;
				};
			};
		};

		usb_con: connector {
			compatible = "usb-c-connector";
			label = "USB-C";
			data-role = "dual";
			power-role = "dual";
			try-power-role = "sink";
			op-sink-microwatt = <1000000>;
			sink-pdos =
				<PDO_FIXED(5000, 1000, PDO_FIXED_USB_COMM)>;
			source-pdos =
				<PDO_FIXED(5000, 3000, PDO_FIXED_USB_COMM)>;

			altmodes {
				#address-cells = <1>;
				#size-cells = <0>;

				altmode@0 {
					reg = <0>;
					svid = <0xff01>;
					vdo = <0xffffffff>;
				};
			};

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					usbc0_orien_sw: endpoint {
						remote-endpoint = <&usbdp_phy0_orientation_switch>;
					};
				};

				port@1 {
					reg = <1>;
					dp_altmode_mux: endpoint {
						remote-endpoint = <&usbdp_phy0_dp_altmode_mux>;
					};
				};
			};
		};
	};

	/delete-node/ husb311@4e;
};

/* two m.2 port */
&pcie30phy {
    rockchip,pcie30-phymode = <PHY_MODE_PCIE_NANBNB>;
    status = "okay";
};

&pcie3x2 {
    reset-gpios = <&gpio1 RK_PB7 GPIO_ACTIVE_HIGH>;
    vpcie3v3-supply = <&vcc3v3_pcie30>;
    status = "okay";
};

&pcie3x4 {
    num-lanes = <2>;
    reset-gpios = <&gpio4 RK_PB6 GPIO_ACTIVE_HIGH>;
    vpcie3v3-supply = <&vcc3v3_pcie30>;
    status = "okay";
	/delete-property/ pinctrl-names;
	/delete-property/ pinctrl-0;
};

&vcc3v3_pcie30 {
	gpios = <&gpio2 RK_PB4 GPIO_ACTIVE_HIGH>;
};

//cm588 sound part
&es8388_sound {
	status = "okay";
	hp-det-gpio = <&gpio1 RK_PD5 GPIO_ACTIVE_HIGH>;
	spk-con-gpio = <&gpio1 RK_PD3 GPIO_ACTIVE_HIGH>;
	hp-con-gpio = <&gpio1 RK_PD2 GPIO_ACTIVE_HIGH>;
};

//cm588 hdmi in
&hdmirx_ctrler {
	hdmirx-det-gpios = <&gpio2 RK_PB5 GPIO_ACTIVE_LOW>;
};

&hdmirx_det {
	rockchip,pins = <2 RK_PB5 RK_FUNC_GPIO &pcfg_pull_up>;
};

//cm588 bluetooth
&uart8 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&uart8m1_xfer &uart8m1_ctsn>;
};

&wireless_bluetooth {
	status = "okay";
	uart_rts_gpios = <&gpio3 RK_PA4 GPIO_ACTIVE_LOW>;
	pinctrl-0 = <&uart8m1_rtsn>, <&bt_reset_gpio>, <&bt_wake_gpio>, <&bt_irq_gpio>;
	pinctrl-1 = <&uart8_gpios>;
};

//type-c usb3.0 otg
&vbus5v0_typec {
	vin-supply = <&avdd_1v2_s0>;
	/delete-property/ enable-active-high;
	/delete-property/ gpio;
	/delete-property/ pinctrl-names;
	/delete-property/ pinctrl-0;
};

&usbc0_int{
	rockchip,pins = <0 RK_PD3 RK_FUNC_GPIO &pcfg_pull_up>;
};

&usbdrd3_0 {
	status = "okay";
};

&usbdrd_dwc3_0 {
	dr_mode = "otg";
	usb-role-switch;
	status = "okay";

	port {
		#address-cells = <1>;
		#size-cells = <0>;
		dwc3_0_role_switch: endpoint@0 {
			reg = <0>;
			remote-endpoint = <&usbc0_role_sw>;
		};
	};
};

&u2phy0 {
	status = "okay";
};

&u2phy0_otg {
	status = "okay";
	rockchip,typec-vbus-det;
};

&usbdp_phy0 {
	orientation-switch;
	svid = <0xff01>;
	sbu1-dc-gpios = <&gpio4 RK_PA6 GPIO_ACTIVE_HIGH>;
	sbu2-dc-gpios = <&gpio4 RK_PA7 GPIO_ACTIVE_HIGH>;
	status = "okay";

	port {
		#address-cells = <1>;
		#size-cells = <0>;
		usbdp_phy0_orientation_switch: endpoint@0 {
			reg = <0>;
			remote-endpoint = <&usbc0_orien_sw>;
		};

		usbdp_phy0_dp_altmode_mux: endpoint@1 {
			reg = <1>;
			remote-endpoint = <&dp_altmode_mux>;
		};
	};
};

&usbdp_phy0_u3 {
    status = "okay";
};

&usbdp_phy0_dp {
    status = "disabled";
};

/* type a usb3.0 port */
&usbdrd3_1 {
	status = "okay";
};

&usbdrd_dwc3_1 {
	dr_mode = "host";
	status = "okay";
};

&u2phy1 {
	status = "okay";
};

&u2phy1_otg {
	status = "okay";
	phy-supply = <&vcc5v0_usb30_host1>;
};

&usbdp_phy1 {
	status = "okay";
	rockchip,dp-lane-mux = <2 3>;
};

&usbdp_phy1_u3 {
	status = "okay";
};

//cm588 soft wdt
&wdt {
	status = "okay";
};

/* cm588 can */
&can0 {
	status = "okay";
};

/* usb 2.0 hub, four usb 2.0 port use this hub*/
&usb_host0_ehci {
	status = "okay";
};

&usb_host0_ohci {
	status = "okay";
};

&u2phy2 {
	status = "okay";
};

&u2phy2_host {
	status = "okay";
	phy-supply = <&vcc5v0_usb20>;
};

//mini pcie usb
&u2phy3 {
    status = "okay";
};

&u2phy3_host {
    status = "okay";
    phy-supply = <&vcc5v0_usb20>;
};

//cm588 sdmmc
&sdmmc {
	vmmc-supply = <&vcc_3v3_s3>;
};

/* Two ethernet */
&gmac0 {
	/* Use rgmii-rxid mode to disable rx delay inside Soc */
	phy-mode = "rgmii-rxid";
	clock_in_out = "output";

	snps,reset-gpio = <&gpio4 RK_PB3 GPIO_ACTIVE_LOW>;
	snps,reset-active-low;
	/* Reset time is 20ms, 100ms for rtl8211f */
	snps,reset-delays-us = <0 20000 100000>;

	pinctrl-names = "default";
	pinctrl-0 = <&gmac0_miim
		     &gmac0_tx_bus2
		     &gmac0_rx_bus2
		     &gmac0_rgmii_clk
		     &gmac0_rgmii_bus
		     &eth0_pins>;

	tx_delay = <0x44>;
	/* rx_delay = <0x4f>; */

	phy-handle = <&rgmii_phy0>;
	status = "okay";
};

&mdio0 {
	rgmii_phy0: phy@1 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <0x1>;
		clocks = <&cru REFCLKO25M_ETH0_OUT>;
	};
};

&pcie2x1l1 {
    reset-gpios = <&gpio4 RK_PA2 GPIO_ACTIVE_HIGH>;
	status = "okay";
};

&combphy2_psu {
    status = "okay";
};

/* pcie wifi ap6275p */
&wireless_wlan {
	wifi_chip_type = "ap6275p";
	pinctrl-0 = <&wifi_host_wake_irq>;
};

&pcie2x1l0 {
	rockchip,skip-scan-in-resume;
	rockchip,perst-inactive-ms = <500>;
	vpcie3v3-supply = <&vcc3v3_pcie20_wifi>;
};

&combphy1_ps {
    status = "okay";
};

//cm588 power supply part
&vdd_npu_s0 {
	vin-supply = <&vcc4v0_sys>;
};

&vdd_cpu_big0_s0 {
	vin-supply = <&vcc4v0_sys>;
};

&vdd_cpu_big1_s0 {
	vin-supply = <&vcc4v0_sys>;
};

&vcc_1v8_s0 {
	/delete-property/ regulator-state-mem;
	regulator-state-mem {
		regulator-on-in-suspend;
		regulator-suspend-microvolt = <1800000>;
	};
};

&vcc_3v3_s0 {
    /delete-property/ regulator-state-mem;
    regulator-state-mem {
        regulator-on-in-suspend;
        regulator-suspend-microvolt = <3300000>;
	};
};

&rk806single {
	vcc1-supply = <&vcc4v0_sys>;
	vcc2-supply = <&vcc4v0_sys>;
	vcc3-supply = <&vcc4v0_sys>;
	vcc4-supply = <&vcc4v0_sys>;
	vcc5-supply = <&vcc4v0_sys>;
	vcc6-supply = <&vcc4v0_sys>;
	vcc7-supply = <&vcc4v0_sys>;
	vcc8-supply = <&vcc4v0_sys>;
	vcc9-supply = <&vcc4v0_sys>;
	vcc10-supply = <&vcc4v0_sys>;
	vcc11-supply = <&vcc_2v0_pldo_s3>;
	vcc12-supply = <&vcc4v0_sys>;
	vcc13-supply = <&vcc_1v1_nldo_s3>;
	vcc14-supply = <&vcc_1v1_nldo_s3>;
	vcca-supply = <&vcc4v0_sys>;
};

/* */
&work_led {
	gpios = <&gpio4 RK_PB0 GPIO_ACTIVE_HIGH>;
};

/* cm588 ttl/232/485 part */
&uart3 {
	status = "okay";
};

&uart0 {
	status = "okay";
	pinctrl-0 = <&uart0m2_xfer>;
};

&uart7 {
	status = "okay";
};

//debug uart
&uart2 {
	pinctrl-0 = <&uart2m0_xfer>;
};

&pinctrl {
	dp {
		dp1_hpd: dp1-hpd {
			rockchip,pins = <3 RK_PA1 RK_FUNC_GPIO &pcfg_pull_down>;
		};
	};

	fan {
		vcc5v0_fan_en: vcc5v0-fan-en {
			rockchip,pins = <4 RK_PA5 RK_FUNC_GPIO &pcfg_pull_down>;
		};
	};

	wifi {
		wifi_poweren_gpio: wifi-poweren-gpio {
			rockchip,pins = <0 RK_PC4 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

	bluetooth {
		uart8_gpios: uart8-gpios {
			rockchip,pins = <3 RK_PA4 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};
};

