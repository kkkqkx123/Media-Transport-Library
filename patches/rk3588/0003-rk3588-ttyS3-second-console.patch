From 039c830e1a0c91db553e44d294fc5c879a752606 Mon Sep 17 00:00:00 2001
From: zhanglei <596504085@qq.com>
Date: Wed, 28 Oct 2026 14:53:34 +0800
Subject: [PATCH] rk3588: make ttyS3 a serial console (keep ttyFIQ0 shell)

Add ttyS3 as a second kernel console so UART3 can be used for debugging in
addition to the UART2 fiq-debugger port.

Order matters: /dev/console follows the LAST console= argument, and the
buildroot init runs "::respawn:-/bin/sh" on /dev/console. Keeping console=ttyFIQ0
last therefore leaves the guaranteed root shell on the UART2 debug port
(1500000 8N1, always wired), while console=ttyS3,115200 turns uart3 into a
second log sink and a console device that the fs-overlay inittab (0004) gives
its own shell.

uart3 is already enabled in this DTS (uart3m1: TX GPIO3_B5, RX GPIO3_B6) and
CONFIG_SERIAL_8250_CONSOLE is on, so no driver or Kconfig change is needed.

IMPORTANT: &gmac1 must stay disabled on this board. gmac1_tx_bus2 muxes
GPIO3_B5 (gmac1_txen) and gmac1_clkinout muxes GPIO3_B6, i.e. exactly the
uart3 pins; enabling gmac1 made ttyS3 completely silent and also broke the
ethernet naming (see 0002).

---
 .../arm64/boot/dts/rockchip/ztl-rk3588-cm.dts    | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/kernel-6.1/arch/arm64/boot/dts/rockchip/ztl-rk3588-cm.dts b/kernel-6.1/arch/arm64/boot/dts/rockchip/ztl-rk3588-cm.dts
index b6360607e..b84f8684f 100644
--- a/kernel-6.1/arch/arm64/boot/dts/rockchip/ztl-rk3588-cm.dts
+++ b/kernel-6.1/arch/arm64/boot/dts/rockchip/ztl-rk3588-cm.dts
@@ -20,6 +20,22 @@
 	model = "ztl, CM588";
 	compatible = "rockchip,rk3588-evb7-v11", "rockchip,rk3588";
 
+	/*
+	 * Serial consoles.
+	 * /dev/console follows the LAST console= argument, so with
+	 *   console=ttyS3,115200 -> uart3 (m1 pins, GPIO3_B5/B6), kernel log
+	 *   console=ttyFIQ0      -> UART2 debug port, kernel log AND the
+	 *                           "::respawn:-/bin/sh" root shell
+	 * the guaranteed shell stays on the UART2 debug port, while ttyS3 gets
+	 * its own shell from /etc/inittab (fs-overlay).
+	 * NOTE: keep &gmac1 disabled - gmac1_tx_bus2 muxes GPIO3_B5 away from
+	 * uart3 and silently kills this console (see
+	 * docs/hw/RK3588_UART_CONSOLE_AND_SERIAL_ACCESS.md).
+	 */
+	chosen {
+		bootargs = "earlycon=uart8250,mmio32,0xfeb50000 console=ttyS3,115200 console=ttyFIQ0 irqchip.gicv3_pseudo_nmi=0 root=PARTUUID=614e0000-0000 rw rootwait rcupdate.rcu_expedited=1 rcu_nocbs=all";
+	};
+
 	vcc4v0_sys: vcc4v0-sys {
 		compatible = "regulator-fixed";
 		regulator-name = "vcc4v0_sys";
-- 
2.17.1

