From c1b8441672cc26e4112aab23aee4be525a9c978d Mon Sep 17 00:00:00 2001
From: zhanglei <596504085@qq.com>
Date: Thu, 12 Nov 2026 12:00:00 +0800
Subject: [PATCH 1/4] en588: kernel 6.1 XDP/eBPF fragment + pin kernel 6.1

Pin the rk3588 build to the kernel-6.1 tree (fresh worktrees fall back
to a nonexistent 5.10 otherwise) and add a minimal AF_XDP/eBPF config
fragment for the MTL native_af_xdp backend. Unlike the old rk3588
0001, this does NOT replace rockchip_linux_defconfig with a 919-line
copy - only the delta rides in ztl_rk3588.config, so evb builds are
unaffected apart from the benign fragment default.

---
 .../rk3588/rockchip_rk3588_ztl_en588_defconfig     |  1 +
 device/rockchip/common/configs/Config.in.kernel    |  1 +
 kernel-6.1/arch/arm64/configs/ztl_rk3588.config    | 14 ++++++++++++++
 3 files changed, 16 insertions(+)
 create mode 100644 kernel-6.1/arch/arm64/configs/ztl_rk3588.config

diff --git a/device/rockchip/.chips/rk3588/rockchip_rk3588_ztl_en588_defconfig b/device/rockchip/.chips/rk3588/rockchip_rk3588_ztl_en588_defconfig
index 0367a66..a08f2b8 100644
--- a/device/rockchip/.chips/rk3588/rockchip_rk3588_ztl_en588_defconfig
+++ b/device/rockchip/.chips/rk3588/rockchip_rk3588_ztl_en588_defconfig
@@ -1,2 +1,3 @@
 RK_KERNEL_DTS_NAME="ztl-rk3588-en"
 RK_USE_FIT_IMG=y
+RK_KERNEL_PREFERRED="6.1"
diff --git a/device/rockchip/common/configs/Config.in.kernel b/device/rockchip/common/configs/Config.in.kernel
index 95556f7..e9bf12c 100644
--- a/device/rockchip/common/configs/Config.in.kernel
+++ b/device/rockchip/common/configs/Config.in.kernel
@@ -47,6 +47,7 @@ config RK_KERNEL_CFG_FRAGMENTS_BASIC
 
 config RK_KERNEL_CFG_FRAGMENTS
 	string "defconfig fragments"
+	default "ztl_rk3588.config" if RK_CHIP_FAMILY = "rk3588"
 
 config RK_KERNEL_DTS_NAME
 	string "device-tree script name"
diff --git a/kernel-6.1/arch/arm64/configs/ztl_rk3588.config b/kernel-6.1/arch/arm64/configs/ztl_rk3588.config
new file mode 100644
index 0000000..11b6720
--- /dev/null
+++ b/kernel-6.1/arch/arm64/configs/ztl_rk3588.config
@@ -0,0 +1,14 @@
+# en588: AF_XDP/eBPF delta for the MTL native_af_xdp backend.
+# Merged over rockchip_linux_defconfig via RK_KERNEL_CFG_FRAGMENTS.
+CONFIG_XDP_SOCKETS=y
+CONFIG_XDP_SOCKETS_DIAG=y
+CONFIG_BPF_SYSCALL=y
+CONFIG_BPF_JIT=y
+CONFIG_BPF_JIT_ALWAYS_ON=y
+CONFIG_BPF_UNPRIV_DEFAULT_OFF=y
+CONFIG_BPF_STREAM_PARSER=y
+CONFIG_CGROUP_BPF=y
+CONFIG_HUGETLBFS=y
+CONFIG_DEBUG_INFO=y
+CONFIG_DEBUG_INFO_BTF=y
+# CONFIG_DEBUG_INFO_REDUCED is not set
-- 
2.56.0

