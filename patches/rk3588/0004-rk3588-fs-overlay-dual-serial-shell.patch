From ed6a7214a9ea2279daedd4fdd0a648d5907847d3 Mon Sep 17 00:00:00 2001
From: zhanglei <596504085@qq.com>
Date: Wed, 28 Oct 2026 14:53:35 +0800
Subject: [PATCH] rk3588/fs-overlay: passwordless shell on both serial consoles

Replace the stock buildroot inittab with one that keeps the automatic root
shell on /dev/console (= ttyFIQ0, UART2 debug port) and adds a second one on
ttyS3 (uart3, 115200 set by console=ttyS3,115200 from 0003).

Both lines are "::respawn:-/bin/sh" / "ttyS3::respawn:-/bin/sh": busybox init
opens the device named by the id field and runs the shell on it, so neither
port depends on getty/login and both give the same passwordless root shell the
buildroot default gives on /dev/console.

The "# GENERIC_SERIAL" marker line of the stock template is deliberately left
out: buildroot's BUSYBOX_SET_GETTY hook (package/busybox/busybox.mk) rewrites
that line according to BR2_TARGET_SERIAL_SHELL_*, which would spawn a second
shell competing for /dev/console.

Rationale: after the 2026-10-28 image made ttyS3 the only shell and it stayed
silent (uart3 pins stolen by gmac1), the board had no usable console at all.
With this inittab the UART2 debug port always has a shell.

---
 .../rockchip/rk3588/fs-overlay/etc/inittab    | 31 +++++++++++++++++++
 1 file changed, 31 insertions(+)
 create mode 100644 buildroot/board/rockchip/rk3588/fs-overlay/etc/inittab

diff --git a/buildroot/board/rockchip/rk3588/fs-overlay/etc/inittab b/buildroot/board/rockchip/rk3588/fs-overlay/etc/inittab
new file mode 100644
index 000000000..5d157f240
--- /dev/null
+++ b/buildroot/board/rockchip/rk3588/fs-overlay/etc/inittab
@@ -0,0 +1,31 @@
+# /etc/inittab - ztl CM588 (Rockchip buildroot)
+#
+# Two independent interactive consoles, both as a passwordless root shell:
+#   * /dev/console -> last console= on the cmdline -> ttyFIQ0 (UART2 debug
+#     port, 1500000 8N1): the always-present fallback, present even if the
+#     UART3 header is mis-wired.
+#   * ttyS3        -> uart3 (TTL header), 115200 8N1 set by console=ttyS3,115200.
+#
+# Both use "-/bin/sh" (login shell, no getty/login prompt), which is the same
+# mechanism buildroot uses for /dev/console via BR2_TARGET_SERIAL_SHELL_SH.
+#
+# NOTE: do NOT add the "# GENERIC_SERIAL" marker line to this file. buildroot's
+# BUSYBOX_SET_GETTY hook (package/busybox/busybox.mk) rewrites that line and
+# would spawn a second shell competing for /dev/console.
+
+::sysinit:/bin/mount -t proc proc /proc
+::sysinit:/bin/mkdir -p /dev/pts /dev/shm
+::sysinit:/bin/mount -a
+::sysinit:/bin/mkdir -p /run/lock/subsys
+::sysinit:/sbin/swapon -a
+null::sysinit:/bin/ln -sf /proc/self/fd /dev/fd
+null::sysinit:/bin/ln -sf /proc/self/fd/0 /dev/stdin
+null::sysinit:/bin/ln -sf /proc/self/fd/1 /dev/stdout
+null::sysinit:/bin/ln -sf /proc/self/fd/2 /dev/stderr
+::sysinit:/bin/hostname -F /etc/hostname
+::sysinit:/etc/init.d/rcS
+::respawn:-/bin/sh
+ttyS3::respawn:-/bin/sh
+::shutdown:/etc/init.d/rcK
+::shutdown:/sbin/swapoff -a
+::shutdown:/bin/umount -a -r
-- 
2.17.1

