From 96242875d1dec252486c1134fdcca8237d089af9 Mon Sep 17 00:00:00 2001
From: zhanglei <596504085@qq.com>
Date: Thu, 12 Nov 2026 12:00:00 +0800
Subject: [PATCH 2/4] en588: buildroot network - static/DHCP dual-IP + DNS

rk3568 reference (0001-IP-DHCP-IP/0002-network): static primary
192.168.80.202 plus a DHCP secondary address, so the board keeps a
fixed management IP and still gets a LAN address when DHCP exists.
Both managers are covered: ifupdown (/etc/network/interfaces +
udhcpc secondary script) and systemd-networkd (10-eth0.network).
A dedicated buildroot defconfig keeps this board-scoped.

---
 .../en588/fs-overlay/etc/network/interfaces       | 14 ++++++++++++++
 .../rockchip/en588/fs-overlay/etc/resolv.conf     |  2 ++
 .../etc/systemd/network/10-eth0.network           |  9 +++++++++
 .../en588/fs-overlay/etc/udhcpc-secondary.script  | 15 +++++++++++++++
 buildroot/configs/rockchip_rk3588_en588_defconfig |  5 +++++
 .../rk3588/rockchip_rk3588_ztl_en588_defconfig    |  1 +
 6 files changed, 46 insertions(+)
 create mode 100644 buildroot/board/rockchip/en588/fs-overlay/etc/network/interfaces
 create mode 100644 buildroot/board/rockchip/en588/fs-overlay/etc/resolv.conf
 create mode 100644 buildroot/board/rockchip/en588/fs-overlay/etc/systemd/network/10-eth0.network
 create mode 100755 buildroot/board/rockchip/en588/fs-overlay/etc/udhcpc-secondary.script
 create mode 100644 buildroot/configs/rockchip_rk3588_en588_defconfig

diff --git a/buildroot/board/rockchip/en588/fs-overlay/etc/network/interfaces b/buildroot/board/rockchip/en588/fs-overlay/etc/network/interfaces
new file mode 100644
index 0000000..cb82f89
--- /dev/null
+++ b/buildroot/board/rockchip/en588/fs-overlay/etc/network/interfaces
@@ -0,0 +1,14 @@
+auto lo
+iface lo inet loopback
+
+# Primary: static IP (management/access)
+auto eth0
+iface eth0 inet static
+    address 192.168.80.202
+    netmask 255.255.255.0
+    gateway 192.168.80.254
+    dns-nameservers 114.114.114.114 8.8.8.8
+    # Secondary: obtain an additional address via DHCP without replacing
+    # the static primary address above (dual-IP mode).
+    post-up udhcpc -i eth0 -b -p /var/run/udhcpc.eth0.pid -s /etc/udhcpc-secondary.script >/dev/null 2>&1 || true
+    pre-down kill "$(cat /var/run/udhcpc.eth0.pid 2>/dev/null)" 2>/dev/null || true
diff --git a/buildroot/board/rockchip/en588/fs-overlay/etc/resolv.conf b/buildroot/board/rockchip/en588/fs-overlay/etc/resolv.conf
new file mode 100644
index 0000000..f5d24a1
--- /dev/null
+++ b/buildroot/board/rockchip/en588/fs-overlay/etc/resolv.conf
@@ -0,0 +1,2 @@
+nameserver 114.114.114.114
+nameserver 8.8.8.8
diff --git a/buildroot/board/rockchip/en588/fs-overlay/etc/systemd/network/10-eth0.network b/buildroot/board/rockchip/en588/fs-overlay/etc/systemd/network/10-eth0.network
new file mode 100644
index 0000000..6872c3b
--- /dev/null
+++ b/buildroot/board/rockchip/en588/fs-overlay/etc/systemd/network/10-eth0.network
@@ -0,0 +1,9 @@
+[Match]
+Name=eth0
+
+[Network]
+Address=192.168.80.202/24
+Gateway=192.168.80.254
+DNS=114.114.114.114
+DNS=8.8.8.8
+DHCP=ipv4
diff --git a/buildroot/board/rockchip/en588/fs-overlay/etc/udhcpc-secondary.script b/buildroot/board/rockchip/en588/fs-overlay/etc/udhcpc-secondary.script
new file mode 100755
index 0000000..ab94305
--- /dev/null
+++ b/buildroot/board/rockchip/en588/fs-overlay/etc/udhcpc-secondary.script
@@ -0,0 +1,15 @@
+#!/bin/sh
+# udhcpc helper: add the DHCP lease as a secondary IP on the interface,
+# keeping the statically configured primary address intact (dual-IP).
+IFACE="${interface:-eth0}"
+case "$1" in
+    bound|renew)
+        [ -z "$ip" ] && exit 0
+        ifconfig "${IFACE}:1" "$ip" netmask "$subnet" 2>/dev/null || \
+            ip addr add "$ip/$subnet" dev "$IFACE" 2>/dev/null || true
+        ;;
+    deconfig)
+        ifconfig "${IFACE}:1" down 2>/dev/null || true
+        ;;
+esac
+exit 0
diff --git a/buildroot/configs/rockchip_rk3588_en588_defconfig b/buildroot/configs/rockchip_rk3588_en588_defconfig
new file mode 100644
index 0000000..f7a8ebe
--- /dev/null
+++ b/buildroot/configs/rockchip_rk3588_en588_defconfig
@@ -0,0 +1,5 @@
+#include "rockchip_rk3588_defconfig"
+
+# en588 board overlay: static/DHCP dual-IP + DNS (ifupdown and
+# systemd-networkd profiles; see 0003 for which one is live).
+BR2_ROOTFS_OVERLAY+="board/rockchip/en588/fs-overlay"
diff --git a/device/rockchip/.chips/rk3588/rockchip_rk3588_ztl_en588_defconfig b/device/rockchip/.chips/rk3588/rockchip_rk3588_ztl_en588_defconfig
index a08f2b8..f2c67fc 100644
--- a/device/rockchip/.chips/rk3588/rockchip_rk3588_ztl_en588_defconfig
+++ b/device/rockchip/.chips/rk3588/rockchip_rk3588_ztl_en588_defconfig
@@ -1,3 +1,4 @@
 RK_KERNEL_DTS_NAME="ztl-rk3588-en"
 RK_USE_FIT_IMG=y
 RK_KERNEL_PREFERRED="6.1"
+RK_BUILDROOT_BASE_CFG="rk3588_en588"
